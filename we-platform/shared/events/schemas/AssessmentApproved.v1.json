{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-platform.local/events/AssessmentApproved.v1.json",
  "title": "AssessmentApproved",
  "description": "Published when a teacher approves an assessment submission. Immutable once published.",
  "type": "object",
  "required": [
    "eventId",
    "correlationId",
    "occurredAt",
    "organisationId",
    "version",
    "assessmentId",
    "studentUserId",
    "submissionId",
    "evidenceId",
    "approvedByTeacherUserId",
    "approvedAt",
    "microSkillResults"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organisationId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "assessmentId": { "type": "string", "format": "uuid" },
    "studentUserId": { "type": "string" },
    "submissionId": { "type": "string", "format": "uuid" },
    "evidenceId": { "type": "string", "format": "uuid" },
    "approvedByTeacherUserId": { "type": "string" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "microSkillResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/microSkillResult" }
    }
  },
  "$defs": {
    "microSkillResult": {
      "type": "object",
      "required": ["microSkillId", "mark", "feedback"],
      "properties": {
        "microSkillId": { "type": "string", "format": "uuid" },
        "mark": { "type": "number" },
        "feedback": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
